# ── Sitio ────────────────────────────────────────────────
# URL pública final (en Vercel: https://tu-dominio.com.ar). Sin barra al final.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase (Project Settings → API) ────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# ¡SECRETA! Solo en el servidor / Vercel. Nunca con prefijo NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# ── Mercado Pago (Tus integraciones → Credenciales) ──────
# Usá primero las credenciales de PRUEBA y después las de PRODUCCIÓN.
MP_ACCESS_TOKEN=
# Clave secreta de Webhooks (Tus integraciones → Webhooks → "Clave secreta")
MP_WEBHOOK_SECRET=

# ── Notificaciones al dueño ──────────────────────────────
# Telegram (recomendado: aviso instantáneo y gratis en el celular)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email vía Resend (opcional)
RESEND_API_KEY=
OWNER_EMAIL=
EMAIL_FROM=Manjar Bistro <pedidos@tudominio.com.ar>
